PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Lead_db
DB_USER=postgres
DB_PASSWORD=root

JWT_ACCESS_SECRET=your_access_secret_change_this
JWT_REFRESH_SECRET=your_refresh_secret_change_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://127.0.0.1:6379
IMPORT_WORKER_CONCURRENCY=1
PRIVATE_UPLOAD_DIR=F:/LeadTask/private-uploads


# PostgreSQL connection pool
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=10000